{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "tags": ["-lintignore"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["lefthook"],
  "ignoreWorkspaces": ["packages/md-extractor"],
  "workspaces": {
    "packages/**": {
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/web-app": {
      "ignore": [
        "public/sw.js",
        "src/components/ui/**",
        "src/domain/articles.ts",
        "src/features/articles/registration/common/types.ts"
      ],
      "ignoreDependencies": [
        "@prisma/client",
        "@radix-ui/react-checkbox",
        "clsx",
        "pg",
        "tailwind-merge"
      ]
    },
    "packages/db": {
      "ignoreDependencies": ["@prisma/client", "pg"]
    }
  }
}
