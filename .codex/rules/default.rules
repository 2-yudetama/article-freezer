# https://developers.openai.com/codex/rules

# 許可系

prefix_rule(
    pattern = ["git", "push", "origin"],
    decision = "allow",
    justification = "origin への branch push を許可",
    match = [
        "git push origin issue/123",
        "git push origin HEAD",
        "git push origin issue/123 --dry-run",
    ],
    not_match = [
        "git push upstream issue/123",
        "git push --force origin issue/123",
    ],
)

prefix_rule(
    # The prefix to match.
    pattern = ["gh", ["repo", "pr", "issue", "run", "workflow", "api"]],

    # The action to take when Codex requests to run a matching command.
    decision = "allow",
)

# 禁止系

prefix_rule(
    pattern = ["git", "add", [".", "-A", "--all", "-u", ":/"]],
    decision = "forbidden",
    justification = "対象ファイルを明示して stage してください",
    match = [
        "git add .",
        "git add -A",
        "git add --all",
        "git add -u",
        "git add :/",
    ],
    not_match = [
        "git add docs/draft/ai-harness/workflow.md",
        "git add packages/web-app/src/app/page.tsx",
    ],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "変更破棄を伴う git reset は禁止です",
    match = [
        "git reset --hard",
        "git reset --hard HEAD",
    ],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "未追跡ファイルの一括削除は禁止です",
    match = [
        "git clean -fd",
        "git clean -xdf",
    ],
)

prefix_rule(
    pattern = ["git", ["merge", "rebase"]],
    decision = "forbidden",
    justification = "merge / rebase はハーネスの自動操作では禁止です",
    match = [
        "git merge main",
        "git rebase main",
    ],
)

prefix_rule(
    pattern = ["git", "commit", ["--no-verify", "-n", "--amend"]],
    decision = "forbidden",
    justification = "commit 前検証の bypass や履歴修正は禁止です",
    match = [
        "git commit --no-verify -m \"skip hooks\"",
        "git commit -n -m \"skip hooks\"",
        "git commit --amend",
    ],
)

prefix_rule(
    pattern = ["git", "checkout", "--"],
    decision = "forbidden",
    justification = "変更破棄を伴う checkout は禁止です",
    match = [
        "git checkout -- docs/draft/ai-harness/workflow.md",
    ],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--force-with-lease"]],
    decision = "forbidden",
    justification = "force push はハーネスの自動操作では禁止です",
    match = [
        "git push --force origin issue/123",
        "git push -f origin issue/123",
        "git push --force-with-lease origin issue/123",
    ],
)

prefix_rule(
    pattern = ["git", "push", "origin", ["--force", "-f", "--force-with-lease"]],
    decision = "forbidden",
    justification = "force push はハーネスの自動操作では禁止です",
    match = [
        "git push origin --force issue/123",
        "git push origin -f issue/123",
        "git push origin --force-with-lease issue/123",
    ],
)

prefix_rule(
    pattern = ["gh", ["repo", "issue"], "delete"],
    decision = "forbidden",
    justification = "DELETE 系 GitHub 操作は禁止です",
    match = [
        "gh repo delete owner/ai-friend-prototype",
        "gh issue delete 123",
    ],
)

prefix_rule(
    pattern = [
        "gh",
        "repo",
        ["archive", "create", "delete", "edit", "fork", "rename", "transfer"],
    ],
    decision = "forbidden",
    justification = "repository の作成、削除、移管、設定変更は禁止です",
    match = [
        "gh repo archive owner/project",
        "gh repo create project-copy",
        "gh repo delete owner/project",
        "gh repo edit owner/project --description \"updated\"",
        "gh repo fork owner/project",
        "gh repo rename project-copy",
        "gh repo transfer owner/project archive",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", ["close", "merge"]],
    decision = "forbidden",
    justification = "PR close / merge はハーネスの自動操作対象外です",
    match = [
        "gh pr close 123",
        "gh pr merge 123",
    ],
)

prefix_rule(
    pattern = ["gh", "run", ["cancel", "delete", "rerun", "watch"]],
    decision = "forbidden",
    justification = "CI workflow run の再実行、停止、削除、監視は禁止です",
    match = [
        "gh run cancel 123",
        "gh run delete 123",
        "gh run rerun 123",
        "gh run watch 123",
    ],
)

prefix_rule(
    pattern = ["gh", "workflow", ["disable", "enable", "run"]],
    decision = "forbidden",
    justification = "CI workflow の起動、停止、設定変更は禁止です",
    match = [
        "gh workflow disable build.yml",
        "gh workflow enable build.yml",
        "gh workflow run build.yml",
    ],
)

prefix_rule(
    pattern = ["gh", "api", "--method", "DELETE"],
    decision = "forbidden",
    justification = "DELETE 系 GitHub API 操作は禁止です",
    match = [
        "gh api --method DELETE repos/owner/repo/issues/123",
    ],
)

prefix_rule(
    pattern = ["gh", "api", "-X", "DELETE"],
    decision = "forbidden",
    justification = "DELETE 系 GitHub API 操作は禁止です",
    match = [
        "gh api -X DELETE repos/owner/repo/issues/123",
    ],
)

prefix_rule(
    pattern = ["gh", "api", "--method=DELETE"],
    decision = "forbidden",
    justification = "DELETE 系 GitHub API 操作は禁止です",
    match = [
        "gh api --method=DELETE repos/owner/repo/issues/123",
    ],
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-r", "-R", "--recursive"]],
    decision = "forbidden",
    justification = "再帰削除はハーネスの自動操作では禁止です",
    match = [
        "rm -rf docs",
        "rm -fr packages/web-app",
        "rm -r tmp",
        "rm -R tmp",
        "rm --recursive tmp",
    ],
)

prefix_rule(
    pattern = ["rm", ["-f"], ["-r", "-R", "--recursive"]],
    decision = "forbidden",
    justification = "再帰削除はハーネスの自動操作では禁止です",
    match = [
        "rm -f -r tmp",
        "rm -f -R tmp",
        "rm -f --recursive tmp",
    ],
)

prefix_rule(
    pattern = ["rm", ["-r", "-R", "--recursive"], ["-f"]],
    decision = "forbidden",
    justification = "再帰削除はハーネスの自動操作では禁止です",
    match = [
        "rm -r -f tmp",
        "rm -R -f tmp",
        "rm --recursive -f tmp",
    ],
)
