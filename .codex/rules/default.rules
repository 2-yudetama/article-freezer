# 文脈が不要で常に禁止したいコマンドと、自動運用で必要な代表コマンドを rules で制御する
# ロール判定、issue スコープ判定、ブランチ状態の確認など文脈依存の制御は hooks やドキュメント運用に委ねる

# 禁止系

prefix_rule(
    pattern = ["git", "add", [".", "-A", "--all", "-u", ":/"]],
    decision = "forbidden",
    justification = "対象ファイルを明示して stage してください",
    match = [
        "git add .",
        "git add -A",
        "git add --all",
        "git add -u",
        "git add :/",
    ],
    not_match = [
        "git add docs/draft/ai-harness/workflow.md",
        "git add packages/web-app/src/app/page.tsx",
    ],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "変更破棄を伴う git reset は禁止です",
    match = [
        "git reset --hard",
        "git reset --hard HEAD",
    ],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "未追跡ファイルの一括削除は禁止です",
    match = [
        "git clean -fd",
        "git clean -xdf",
    ],
)

prefix_rule(
    pattern = ["git", ["merge", "rebase"]],
    decision = "forbidden",
    justification = "merge / rebase はハーネスの自動操作では禁止です",
    match = [
        "git merge main",
        "git rebase main",
    ],
)

prefix_rule(
    pattern = ["git", "checkout", "--"],
    decision = "forbidden",
    justification = "変更破棄を伴う checkout は禁止です",
    match = [
        "git checkout -- docs/draft/ai-harness/workflow.md",
    ],
)

prefix_rule(
    pattern = ["gh", ["repo", "issue"], "delete"],
    decision = "forbidden",
    justification = "DELETE 系 GitHub 操作は禁止です",
    match = [
        "gh repo delete 2-yudetama/article-freezer",
        "gh issue delete 123",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "close"],
    decision = "forbidden",
    justification = "PR close はハーネスの自動操作対象外です",
    match = [
        "gh pr close 123",
    ],
)

prefix_rule(
    pattern = ["gh", "api", "--method", "DELETE"],
    decision = "forbidden",
    justification = "DELETE 系 GitHub API 操作は禁止です",
    match = [
        "gh api --method DELETE repos/2-yudetama/article-freezer/issues/123",
    ],
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-r", "-R", "--recursive"]],
    decision = "forbidden",
    justification = "再帰削除はハーネスの自動操作では禁止です",
    match = [
        "rm -rf docs",
        "rm -fr packages/web-app",
        "rm -r tmp",
        "rm -R tmp",
        "rm --recursive tmp",
    ],
)

prefix_rule(
    pattern = ["rm", ["-f"], ["-r", "-R", "--recursive"]],
    decision = "forbidden",
    justification = "再帰削除はハーネスの自動操作では禁止です",
    match = [
        "rm -f -r tmp",
        "rm -f -R tmp",
        "rm -f --recursive tmp",
    ],
)

prefix_rule(
    pattern = ["rm", ["-r", "-R", "--recursive"], ["-f"]],
    decision = "forbidden",
    justification = "再帰削除はハーネスの自動操作では禁止です",
    match = [
        "rm -r -f tmp",
        "rm -R -f tmp",
        "rm --recursive -f tmp",
    ],
)

# 許可系

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "明示ファイルの stage は Generator の commit 作成に必要です",
    match = [
        "git add docs/agent/workflow.md",
        "git add packages/web-app/src/app/page.tsx",
    ],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Generator の issue スコープ内 commit 作成に必要です",
    match = [
        "git commit -m \"📝 エージェントワークフロー手順を整理 (#123)\"",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "allow",
    justification = "Manager の PR 最終化で branch push が必要です",
    match = [
        "git push -u origin issue/123",
    ],
)

prefix_rule(
    pattern = ["gh", "issue", ["comment", "create", "view"]],
    decision = "allow",
    justification = "ワークフロー Output 投稿、issue 分割、状態確認に必要です",
    match = [
        "gh issue comment 123 --body \"AI: Planner Output\"",
        "gh issue create --title \"サブ issue\" --body \"body\"",
        "gh issue view 123 --comments",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", ["create", "list"]],
    decision = "allow",
    justification = "PR 最終化と既存 PR 確認に必要です",
    match = [
        "gh pr create --base main --head issue/123 --title \"title\" --body \"body\"",
        "gh pr list --head issue/123 --state all",
    ],
)

prefix_rule(
    pattern = ["gh", "api"],
    decision = "allow",
    justification = "Sub-issues API と GitHub 状態確認に必要です",
    match = [
        "gh api repos/2-yudetama/article-freezer/issues/123 --jq .id",
        "gh api -X POST repos/2-yudetama/article-freezer/issues/123/sub_issues -F sub_issue_id=456",
    ],
)

prefix_rule(
    pattern = ["uv", "run"],
    decision = "allow",
    justification = "md-extractor の typecheck と Python formatter hook に必要です",
    match = [
        "uv run pyright",
        "uv run --project packages/md-extractor ruff check --fix packages/md-extractor/src/main.py",
    ],
)
